{
  "name": "jev-pinball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "dev": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^17.2.3",
    "pixi.js": "^8.14.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
